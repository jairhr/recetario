# Propósito: URL base de la API de TheMealDB que consume src/lib/mealdb.ts.
# Valor por defecto: https://www.themealdb.com/api/json/v1/1
# Obligatoria: No. Si se omite o queda vacía, la aplicación usa el valor
#              por defecto definido en src/lib/mealdb.ts.
# Nota: escribe la URL sin barra final. La API pública no requiere API key.
MEALDB_API_URL=https://www.themealdb.com/api/json/v1/1
